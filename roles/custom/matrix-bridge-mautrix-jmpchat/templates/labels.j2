{% if matrix_bridge_mautrix_jmpchat_container_labels_traefik_enabled %}
traefik.enable=true

{% if matrix_bridge_mautrix_jmpchat_container_labels_traefik_docker_network %}
traefik.docker.network={{ matrix_bridge_mautrix_jmpchat_container_labels_traefik_docker_network }}
{% endif %}

traefik.http.services.matrix-mautrix-jmpchat-metrics.loadbalancer.server.port=8000

{% if matrix_bridge_mautrix_jmpchat_container_labels_metrics_enabled %}
############################################################
#                                                          #
# Metrics                                                  #
#                                                          #
############################################################

{% if matrix_bridge_mautrix_jmpchat_container_labels_metrics_middleware_basic_auth_enabled %}
traefik.http.middlewares.matrix-mautrix-jmpchat-metrics-basic-auth.basicauth.users={{ matrix_bridge_mautrix_jmpchat_container_labels_metrics_middleware_basic_auth_users }}
traefik.http.routers.matrix-mautrix-jmpchat-metrics.middlewares=matrix-mautrix-jmpchat-metrics-basic-auth
{% endif %}

traefik.http.routers.matrix-mautrix-jmpchat-metrics.rule={{ matrix_bridge_mautrix_jmpchat_container_labels_metrics_traefik_rule }}

{% if matrix_bridge_mautrix_jmpchat_container_labels_metrics_traefik_priority | int > 0 %}
traefik.http.routers.matrix-mautrix-jmpchat-metrics.priority={{ matrix_bridge_mautrix_jmpchat_container_labels_metrics_traefik_priority }}
{% endif %}

traefik.http.routers.matrix-mautrix-jmpchat-metrics.service=matrix-mautrix-jmpchat-metrics
traefik.http.routers.matrix-mautrix-jmpchat-metrics.entrypoints={{ matrix_bridge_mautrix_jmpchat_container_labels_metrics_traefik_entrypoints }}

traefik.http.routers.matrix-mautrix-jmpchat-metrics.tls={{ matrix_bridge_mautrix_jmpchat_container_labels_metrics_traefik_tls | to_json }}
{% if matrix_bridge_mautrix_jmpchat_container_labels_metrics_traefik_tls %}
traefik.http.routers.matrix-mautrix-jmpchat-metrics.tls.certResolver={{ matrix_bridge_mautrix_jmpchat_container_labels_metrics_traefik_tls_certResolver }}
{% endif %}

############################################################
#                                                          #
# /Metrics                                                 #
#                                                          #
############################################################
{% endif %}


{% endif %}

{{ matrix_bridge_mautrix_jmpchat_container_labels_additional_labels }}
