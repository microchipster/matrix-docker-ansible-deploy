#jinja2: lstrip_blocks: True
[Unit]
Description=Matrix Mautrix Android SMS/MMS bridge
{% for service in matrix_bridge_mautrix_android_sms_mms_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in matrix_bridge_mautrix_android_sms_mms_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} matrix-mautrix-android-sms-mms 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm matrix-mautrix-android-sms-mms 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
			--rm \
			--name=matrix-mautrix-android-sms-mms \
			--log-driver=json-file --log-opt max-size=10m --log-opt max-file=2 \
			--user={{ matrix_user_uid }}:{{ matrix_user_gid }} \
			--cap-drop=ALL \
			--network={{ matrix_bridge_mautrix_android_sms_mms_container_network }} \
			--mount type=bind,src={{ matrix_bridge_mautrix_android_sms_mms_config_path }},dst=/config,ro \
			--mount type=bind,src={{ matrix_bridge_mautrix_android_sms_mms_data_path }},dst=/data \
			--label-file={{ matrix_bridge_mautrix_android_sms_mms_base_path }}/labels \
			--workdir=/data \
			{% for port in matrix_bridge_mautrix_android_sms_mms_container_http_host_bind_ports %}
			-p {{ port }} \
			{% endfor %}
			{% for arg in matrix_bridge_mautrix_android_sms_mms_container_extra_arguments %}
			{{ arg }} \
			{% endfor %}
			{{ matrix_bridge_mautrix_android_sms_mms_container_image }} \
			/usr/bin/mautrix-android-sms-mms -c /config/config.yaml -r /config/registration.yaml --no-update

{% for network in matrix_bridge_mautrix_android_sms_mms_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} matrix-mautrix-android-sms-mms
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach matrix-mautrix-android-sms-mms

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} matrix-mautrix-android-sms-mms 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm matrix-mautrix-android-sms-mms 2>/dev/null || true'
Restart=always
RestartSec=30
SyslogIdentifier=matrix-mautrix-android-sms-mms

[Install]
WantedBy=multi-user.target
