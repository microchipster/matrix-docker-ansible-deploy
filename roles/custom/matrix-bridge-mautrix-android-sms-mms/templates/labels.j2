{% if matrix_bridge_mautrix_android_sms_mms_container_labels_traefik_enabled %}
traefik.enable=true

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_traefik_docker_network %}
traefik.docker.network={{ matrix_bridge_mautrix_android_sms_mms_container_labels_traefik_docker_network }}
{% endif %}

traefik.http.services.matrix-mautrix-android-sms-mms-metrics.loadbalancer.server.port=8000

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_enabled %}
############################################################
#                                                          #
# App pairing API                                          #
#                                                          #
############################################################

traefik.http.services.matrix-mautrix-android-sms-mms-pairing.loadbalancer.server.port={{ matrix_bridge_mautrix_android_sms_mms_pairing_port }}

traefik.http.routers.matrix-mautrix-android-sms-mms-pairing.rule={{ matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_traefik_rule }}

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_traefik_priority | int > 0 %}
traefik.http.routers.matrix-mautrix-android-sms-mms-pairing.priority={{ matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_traefik_priority }}
{% endif %}

traefik.http.routers.matrix-mautrix-android-sms-mms-pairing.service=matrix-mautrix-android-sms-mms-pairing
traefik.http.routers.matrix-mautrix-android-sms-mms-pairing.entrypoints={{ matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_traefik_entrypoints }}

traefik.http.routers.matrix-mautrix-android-sms-mms-pairing.tls={{ matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_traefik_tls | to_json }}
{% if matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_traefik_tls %}
traefik.http.routers.matrix-mautrix-android-sms-mms-pairing.tls.certResolver={{ matrix_bridge_mautrix_android_sms_mms_container_labels_pairing_traefik_tls_certResolver }}
{% endif %}

############################################################
#                                                          #
# /App pairing API                                         #
#                                                          #
############################################################
{% endif %}

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_enabled %}
############################################################
#                                                          #
# CDN file service                                         #
#                                                          #
############################################################

traefik.http.services.matrix-mautrix-android-sms-mms-cdn.loadbalancer.server.port={{ matrix_bridge_mautrix_android_sms_mms_pairing_port }}

traefik.http.routers.matrix-mautrix-android-sms-mms-cdn.rule={{ matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_traefik_rule }}

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_traefik_priority | int > 0 %}
traefik.http.routers.matrix-mautrix-android-sms-mms-cdn.priority={{ matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_traefik_priority }}
{% endif %}

traefik.http.routers.matrix-mautrix-android-sms-mms-cdn.service=matrix-mautrix-android-sms-mms-cdn
traefik.http.routers.matrix-mautrix-android-sms-mms-cdn.entrypoints={{ matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_traefik_entrypoints }}

traefik.http.routers.matrix-mautrix-android-sms-mms-cdn.tls={{ matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_traefik_tls | to_json }}
{% if matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_traefik_tls %}
traefik.http.routers.matrix-mautrix-android-sms-mms-cdn.tls.certResolver={{ matrix_bridge_mautrix_android_sms_mms_container_labels_cdn_traefik_tls_certResolver }}
{% endif %}

############################################################
#                                                          #
# /CDN file service                                        #
#                                                          #
############################################################
{% endif %}

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_enabled %}
############################################################
#                                                          #
# Metrics                                                  #
#                                                          #
############################################################

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_middleware_basic_auth_enabled %}
traefik.http.middlewares.matrix-mautrix-android-sms-mms-metrics-basic-auth.basicauth.users={{ matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_middleware_basic_auth_users }}
traefik.http.routers.matrix-mautrix-android-sms-mms-metrics.middlewares=matrix-mautrix-android-sms-mms-metrics-basic-auth
{% endif %}

traefik.http.routers.matrix-mautrix-android-sms-mms-metrics.rule={{ matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_traefik_rule }}

{% if matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_traefik_priority | int > 0 %}
traefik.http.routers.matrix-mautrix-android-sms-mms-metrics.priority={{ matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_traefik_priority }}
{% endif %}

traefik.http.routers.matrix-mautrix-android-sms-mms-metrics.service=matrix-mautrix-android-sms-mms-metrics
traefik.http.routers.matrix-mautrix-android-sms-mms-metrics.entrypoints={{ matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_traefik_entrypoints }}

traefik.http.routers.matrix-mautrix-android-sms-mms-metrics.tls={{ matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_traefik_tls | to_json }}
{% if matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_traefik_tls %}
traefik.http.routers.matrix-mautrix-android-sms-mms-metrics.tls.certResolver={{ matrix_bridge_mautrix_android_sms_mms_container_labels_metrics_traefik_tls_certResolver }}
{% endif %}

############################################################
#                                                          #
# /Metrics                                                 #
#                                                          #
############################################################
{% endif %}


{% endif %}

