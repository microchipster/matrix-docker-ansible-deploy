#jinja2: lstrip_blocks: True
# Network-specific config options

# Default agent URL pre-filled in the login flow.
default_agent_url: {{ matrix_bridge_mautrix_android_sms_mms_default_agent_url | to_json }}
# Default agent bearer token pre-filled in the login flow.
default_agent_token: {{ matrix_bridge_mautrix_android_sms_mms_default_agent_token | to_json }}
# Should Matrix reactions be sent as plain text messages (`Reacted 👍 to "…"`) instead of being dropped?
# Incoming tapbacks are always bridged as real Matrix reactions.
send_reactions_as_text: {{ matrix_bridge_mautrix_android_sms_mms_send_reactions_as_text | to_json }}
# Automatic catch-up/backfill window in days.
history_default_days: {{ matrix_bridge_mautrix_android_sms_mms_history_default_days | to_json }}
# Maximum outgoing attachment size in megabytes (the MMS carrier limit).
max_attachment_size_mb: {{ matrix_bridge_mautrix_android_sms_mms_max_attachment_size_mb | to_json }}
# Manually overrides the device display name used for the login's remote name / room topic.
device_name: {{ matrix_bridge_mautrix_android_sms_mms_device_name | to_json }}

# Public app pairing API (see the project's `docs/PAIRING_PROTOCOL.md`).
pairing:
    # Controls whether the pairing API listener is started and new app logins are accepted.
    enabled: {{ matrix_bridge_mautrix_android_sms_mms_pairing_enabled | to_json }}
    # The address the pairing API binds to, e.g. ":29322".
    listen: {{ matrix_bridge_mautrix_android_sms_mms_pairing_listen | to_json }}
    # Externally reachable base URL of the bridge, embedded into the pairing payload.
    public_url: {{ matrix_bridge_mautrix_android_sms_mms_pairing_public_url | to_json }}

{% if matrix_bridge_mautrix_android_sms_mms_cdn_enabled | bool -%}
# Bridge-hosted encrypted file service (see the project's `docs/cdn-file-service.md`).
# The app encrypts files and uploads ciphertext; the bridge never sees the key (it stays
# in the link's URL fragment). The section is only rendered while a `cdn_domain` is provisioned.
cdn:
    enabled: true
    domain: {{ matrix_bridge_mautrix_android_sms_mms_cdn_domain | to_json }}
    data_dir: {{ matrix_bridge_mautrix_android_sms_mms_cdn_data_dir | to_json }}
    max_file_bytes: {{ matrix_bridge_mautrix_android_sms_mms_cdn_max_file_bytes | to_json }}
    per_user_cap_bytes: {{ matrix_bridge_mautrix_android_sms_mms_cdn_per_user_cap_bytes | to_json }}
    default_expiry: {{ matrix_bridge_mautrix_android_sms_mms_cdn_default_expiry | to_json }}
    max_expiry: {{ matrix_bridge_mautrix_android_sms_mms_cdn_max_expiry | to_json }}
    gc_interval: {{ matrix_bridge_mautrix_android_sms_mms_cdn_gc_interval | to_json }}
    upload_token: {{ matrix_bridge_mautrix_android_sms_mms_cdn_upload_token | to_json }}
    upload_token_owner: {{ matrix_bridge_mautrix_android_sms_mms_cdn_upload_token_owner | to_json }}
{% endif -%}

# CardDAV address book integration (used by `carddav-login`).
# By default the encryption key is derived from your `carddav-unlock <secret>` and kept
# in memory only, so it is never written to disk. Set a key_file only for on-disk keys.
carddav:
    key_file: {{ matrix_bridge_mautrix_android_sms_mms_carddav_key_file | to_json }}

{% if matrix_bridge_mautrix_android_sms_mms_network_configuration_extension_yaml %}
# Extra network configuration (see matrix_bridge_mautrix_android_sms_mms_network_configuration_extension_yaml).
{{ matrix_bridge_mautrix_android_sms_mms_network_configuration_extension_yaml }}
{% endif %}
